# Copy to .env.production and replace every placeholder before deployment.

BIZMETRICS_PUBLIC_HOST=bizmetrics.example.com
BIZMETRICS_PUBLIC_API_BASE_URL=https://bizmetrics.example.com/api/v1
BIZMETRICS_TLS_EMAIL=ops@example.com
BIZMETRICS_COMPOSE_PROJECT_NAME=bizmetrics-prod
BIZMETRICS_RUNTIME_ENVIRONMENT=production
BIZMETRICS_BACKEND_REPLICAS=1
BIZMETRICS_PRODUCT_MODE=internal-module
BIZMETRICS_MODULE_HOUSEHOLD_ENABLED=false
BIZMETRICS_MODULE_PEOPLE_CORE_ENABLED=false
BIZMETRICS_MODULE_WORKFORCE_COST_ENABLED=false
BIZMETRICS_MODULE_TALENT_SUITE_ENABLED=false
BIZMETRICS_MODULE_TAX_WORKSPACE_ENABLED=false
BIZMETRICS_MODULE_POLICY_CENTER_ENABLED=false
BIZMETRICS_MODULE_BACKUP_UI_ENABLED=false

BIZMETRICS_CADDY_VERSION=2.11.4-alpine
BIZMETRICS_MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
BIZMETRICS_PROMETHEUS_VERSION=v3.12.0
BIZMETRICS_BACKUP_HELPER_IMAGE=alpine:3.23.4

BIZMETRICS_POSTGRES_DB=bizmetrics
BIZMETRICS_POSTGRES_USER=bizmetrics_app
BIZMETRICS_POSTGRES_PASSWORD=replace-with-a-long-random-password
BIZMETRICS_DB_POOL_MAX_SIZE=20
BIZMETRICS_DB_POOL_MIN_IDLE=4

BIZMETRICS_BOOTSTRAP_MODE=bootstrap
BIZMETRICS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BIZMETRICS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
BIZMETRICS_BOOTSTRAP_ADMIN_NICKNAME=系统管理员
BIZMETRICS_BOOTSTRAP_COMPANY_NAME=我的公司
BIZMETRICS_BOOTSTRAP_COMPANY_CREDIT_CODE=
BIZMETRICS_BOOTSTRAP_COMPANY_INDUSTRY=未设置
BIZMETRICS_BOOTSTRAP_COMPANY_TAXPAYER_TYPE=未设置
BIZMETRICS_BOOTSTRAP_COMPANY_CURRENCY=CNY
BIZMETRICS_FLYWAY_ENABLED=true
BIZMETRICS_REGISTRATION_MODE=invite
BIZMETRICS_ALLOWED_ORIGINS=https://bizmetrics.example.com
BIZMETRICS_AUTH_MAX_FAILED_ATTEMPTS=5
BIZMETRICS_AUTH_MAX_FAILED_ATTEMPTS_PER_SOURCE=50
BIZMETRICS_AUTH_FAILURE_WINDOW_MINUTES=15
BIZMETRICS_AUTH_LOCK_MINUTES=15
BIZMETRICS_AUTH_TRUST_FORWARDED_HEADERS=true
BIZMETRICS_PASSWORD_MIN_LENGTH=12
BIZMETRICS_PASSWORD_REQUIRE_COMPLEXITY=true
BIZMETRICS_OUTBOX_ENABLED=true
BIZMETRICS_OUTBOX_CONSUMER_ENABLED=true
BIZMETRICS_OUTBOX_CONSUMER_FIXED_DELAY_MS=5000
BIZMETRICS_OUTBOX_CONSUMER_BATCH_SIZE=20
BIZMETRICS_OUTBOX_CONSUMER_MAX_ATTEMPTS=8
BIZMETRICS_OUTBOX_CONSUMER_STALE_LOCK_MINUTES=10
BIZMETRICS_NOTIFICATIONS_ENABLED=true
BIZMETRICS_NOTIFICATION_REMINDERS_ENABLED=true
BIZMETRICS_NOTIFICATION_REMINDER_FIXED_DELAY_MS=60000
BIZMETRICS_NOTIFICATION_REMINDER_LEASE_MS=600000
BIZMETRICS_NOTIFICATION_TAX_LOOKAHEAD_DAYS=7
BIZMETRICS_NOTIFICATION_PEOPLE_LOOKAHEAD_DAYS=14
BIZMETRICS_NOTIFICATION_RECEIPT_LOOKAHEAD_DAYS=7
BIZMETRICS_NOTIFICATION_DELIVERY_ENABLED=true
BIZMETRICS_NOTIFICATION_DELIVERY_FIXED_DELAY_MS=10000
BIZMETRICS_NOTIFICATION_DELIVERY_BATCH_SIZE=20
BIZMETRICS_NOTIFICATION_DELIVERY_MAX_ATTEMPTS=6
BIZMETRICS_NOTIFICATION_DELIVERY_STALE_LOCK_MINUTES=10
BIZMETRICS_NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=5
BIZMETRICS_SMOKE_EMAIL=admin@example.com
BIZMETRICS_SMOKE_PASSWORD=replace-with-the-current-admin-password
BIZMETRICS_SMOKE_MAX_ATTEMPTS=12
BIZMETRICS_SMOKE_RETRY_DELAY_SECONDS=5
BIZMETRICS_SERVICE_WAIT_TIMEOUT_SECONDS=180

BIZMETRICS_OBJECT_STORAGE_ENABLED=true
BIZMETRICS_MINIO_ACCESS_KEY=replace-with-a-random-access-key
BIZMETRICS_MINIO_SECRET_KEY=replace-with-a-long-random-secret-key
BIZMETRICS_MINIO_BUCKET=bizmetrics
BIZMETRICS_MINIO_REGION=us-east-1
BIZMETRICS_MINIO_EXTERNAL_URL=https://bizmetrics.example.com
BIZMETRICS_MINIO_PRESIGNED_URL_EXPIRY_SECONDS=600
BIZMETRICS_RECEIPT_STORAGE_MAX_BYTES_PER_COMPANY=10737418240
BIZMETRICS_RECEIPT_STORAGE_WARNING_PERCENT=80
BIZMETRICS_RECEIPT_STORAGE_AUDIT_ENABLED=true
BIZMETRICS_RECEIPT_STORAGE_AUDIT_POLL_DELAY_MS=60000
BIZMETRICS_RECEIPT_STORAGE_AUDIT_CADENCE_MS=21600000
BIZMETRICS_RECEIPT_STORAGE_AUDIT_LEASE_MS=1800000
BIZMETRICS_RECEIPT_STORAGE_AUDIT_MAX_OBJECTS=100000
BIZMETRICS_RECEIPT_STORAGE_AUDIT_ORPHAN_GRACE_MS=3600000
BIZMETRICS_RECEIPT_STORAGE_AUDIT_SAMPLE_SIZE=10

BIZMETRICS_BACKUP_RETENTION_DAYS=14
BIZMETRICS_PROMETHEUS_PORT=127.0.0.1:39090
